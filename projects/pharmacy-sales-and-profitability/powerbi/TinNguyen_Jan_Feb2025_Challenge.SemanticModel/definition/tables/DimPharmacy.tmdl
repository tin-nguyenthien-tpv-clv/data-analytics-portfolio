	column Longitude
		dataType: double
		lineageTag: e17b6f7d-a095-40c1-8821-a2e601cbcc77
		dataCategory: Longitude
		summarizeBy: none
		sourceColumn: Longitude

		annotation SummarizationSetBy = Automatic

		annotation PBI_FormatHint = {"isGeneralNumber":true}

	column 'Store Cohort' =
			
			IF( DimPharmacy[OpenDate] < DATE(2024,1,1), "Established", "Opened in window" )
		lineageTag: f34558f8-fc5f-49e1-aee7-d86a494c4c65
		summarizeBy: none

		annotation SummarizationSetBy = Automatic

	column OpenDate
		dataType: dateTime
		formatString: Long Date
		lineageTag: e96d4aba-4740-4c7b-904b-fed22769e5c6
		summarizeBy: none
		sourceColumn: OpenDate

		annotation SummarizationSetBy = Automatic

		annotation UnderlyingDateTimeDataType = Date

	column 'Pharmacy Name' =
			
			LEFT(
			    DimPharmacy[PharmacyName],
			    SEARCH( " #", DimPharmacy[PharmacyName], 1, LEN( DimPharmacy[PharmacyName] ) + 1 ) - 1
			)
		lineageTag: 13f37a7d-f4e4-4768-a498-3f54fa2d3ecb
		summarizeBy: none

		annotation SummarizationSetBy = Automatic

	column 'Latitude Band' =
			
			SWITCH( TRUE(),
			    DimPharmacy[Latitude] < 44, "37-44 N (South)",
			    DimPharmacy[Latitude] < 48, "44-48 N",
			    DimPharmacy[Latitude] < 52, "48-52 N",
			    "52-56 N (North)" )
		lineageTag: 7b0e5c9a-4d21-4f88-a6c3-2e51b0d7f913
		summarizeBy: none

		annotation SummarizationSetBy = Automatic

	hierarchy Geography
